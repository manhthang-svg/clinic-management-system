Project clinic_management_iteration_1 {
  database_type: 'PostgreSQL'
  Note: '''
    Proposed Iteration 1 schema for dbdiagram.io.

    Existing authentication tables from Flyway V1 are included for context.
    All technical UUIDs are UUIDv7 values generated by the application.
    This is a review artifact, not an executable Flyway migration.
  '''
}

// Existing Flyway V1 tables

Table staff_accounts {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  username varchar(50) [not null, unique, note: 'Stored lowercase; compared case-insensitively']
  password_hash text [not null]
  full_name text [not null]
  academic_title text
  phone_number text
  email text
  role varchar(20) [not null, note: 'ADMIN, RECEPTIONIST, DOCTOR, TECHNICIAN, CASHIER']
  status varchar(20) [not null, note: 'ACTIVE, LOCKED']
  password_change_required boolean [not null]
  failed_login_attempts integer [not null, default: 0]
  login_blocked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (role, status) [name: 'idx_staff_accounts_role_status']
  }

  Note: 'Existing table. CHECK constraints enforce lowercase username, allowed role/status values, and non-negative failed-login attempts.'
}

Table auth_sessions {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  staff_account_id uuid [not null]
  created_at timestamptz [not null]
  absolute_expires_at timestamptz [not null]
  revoked_at timestamptz
  revocation_reason varchar(30)

  indexes {
    staff_account_id [name: 'idx_auth_sessions_staff_account_id']
  }

  Note: 'Existing table. Revoked time and reason must either both be null or both be present.'
}

Table refresh_tokens {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  auth_session_id uuid [not null]
  token_hash bytea [not null, unique, note: 'Exactly 32 bytes; raw refresh tokens are never persisted']
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  used_at timestamptz

  indexes {
    auth_session_id [name: 'idx_refresh_tokens_auth_session_id']
  }
}

Table security_audit_events {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  occurred_at timestamptz [not null]
  event_type varchar(40) [not null]
  actor_account_id uuid
  target_account_id uuid
  outcome varchar(10) [not null, note: 'SUCCESS or FAILURE']
  correlation_id varchar(64)

  Note: 'Existing append-only security audit. Never stores passwords, tokens, or medical data.'
}

// Organization and reference catalog

Table departments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  name text [not null]
  type varchar(20) [not null, note: 'CLINICAL or PARACLINICAL']
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    type [name: 'idx_departments_type']
  }

  Note: 'Department-name uniqueness is TBD.'
}

Table service_groups {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  code varchar(30) [not null, unique]
  name text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  Note: 'Reference data required by paraclinical rooms. Ownership and seed strategy are TBD.'
}

Table services {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  department_id uuid [not null]
  service_group_id uuid
  code varchar(40) [not null, unique]
  name text [not null]
  type varchar(20) [not null, note: 'EXAMINATION or PARACLINICAL']
  status varchar(20) [not null, note: 'ACTIVE or INACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (department_id, status) [name: 'idx_services_department_status']
    (service_group_id, status) [name: 'idx_services_group_status']
  }

  Note: 'Iteration 1 reads services for department detail and examination fees; management use cases remain Iteration 2.'
}

Table service_prices {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  service_id uuid [not null]
  clinic_price numeric [not null]
  insurance_price numeric [not null]
  effective_from timestamptz [not null]
  created_by uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (service_id, effective_from) [unique, name: 'uq_service_prices_service_effective_from']
  }

  Note: 'Amounts must be non-negative. Precision, scale, currency, and rounding are TBD.'
}

Table rooms {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  department_id uuid [not null]
  service_group_id uuid
  code varchar(30) [not null, unique]
  name text [not null]
  location text
  type varchar(20) [not null, note: 'EXAMINATION or PARACLINICAL']
  status varchar(20) [not null, note: 'ACTIVE or INACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (department_id, status) [name: 'idx_rooms_department_status']
    service_group_id [name: 'idx_rooms_service_group_id']
  }

  Note: 'A PARACLINICAL room requires a service_group_id; an EXAMINATION room does not.'
}

Table staff_room_assignments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  staff_account_id uuid [not null]
  room_id uuid [not null]
  assigned_at timestamptz [not null]
  removed_at timestamptz
  assigned_by uuid [not null]
  version bigint [not null]

  indexes {
    staff_account_id [name: 'idx_staff_room_assignments_account_id']
    room_id [name: 'idx_staff_room_assignments_room_id']
  }

  Note: 'Flyway must add a partial unique index on (staff_account_id, room_id) WHERE removed_at IS NULL. Shift scheduling is out of scope.'
}

// Patient profiles and reception

Table patients {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  full_name text [not null]
  date_of_birth date
  gender varchar(20) [note: 'MALE, FEMALE, OTHER; requiredness is TBD']
  citizen_id varchar(30) [unique, note: 'Nullable pending a decision for patients without a citizen ID']
  phone_number varchar(30)
  health_insurance_number varchar(30)
  address text
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    phone_number [name: 'idx_patients_phone_number']
    health_insurance_number [name: 'idx_patients_health_insurance_number']
  }

  Note: 'ASSUMPTION: date of birth, gender, and address belong to the administrative profile. Exact required fields and insurance-card history are TBD. Add an expression index on lower(full_name) only after search semantics are approved.'
}

Table visits {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  registration_code varchar(30) [not null, unique]
  patient_id uuid [not null]
  registered_by uuid [not null]
  visit_type varchar(20) [not null, note: 'INSURANCE or SELF_PAID']
  priority boolean [not null, default: false]
  reason_for_visit text [not null]
  initial_symptoms text
  status varchar(30) [not null, note: 'WAITING_FEE_PAYMENT, WAITING_EXAM, IN_EXAM, WAITING_PARACLINICAL, WAITING_CONCLUSION, SKIPPED, COMPLETED, CANCELLED, ABANDONED']
  insurance_number_snapshot varchar(30)
  registered_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (patient_id, registered_at) [name: 'idx_visits_patient_registered_at']
    (status, registered_at) [name: 'idx_visits_status_registered_at']
  }

  Note: 'Flyway must add a partial unique index on patient_id for non-terminal statuses so a patient has at most one active visit.'
}

Table visit_room_assignments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  visit_id uuid [not null]
  room_id uuid [not null]
  queue_date date [not null]
  queue_number integer [not null]
  kind varchar(20) [not null, note: 'REGISTRATION, TRANSFER, REASSIGN']
  reason text
  assigned_by uuid [not null]
  assigned_at timestamptz [not null]
  ended_at timestamptz

  indexes {
    (room_id, queue_date, queue_number) [unique, name: 'uq_visit_room_assignments_queue']
    (room_id, queue_date, ended_at) [name: 'idx_visit_room_assignments_current_queue']
    visit_id [name: 'idx_visit_room_assignments_visit_id']
  }

  Note: 'The active assignment has ended_at IS NULL. Flyway must add a partial unique index on visit_id WHERE ended_at IS NULL. Queue-number reset scope is assumed to be per room per day and requires confirmation.'
}

Table payments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  visit_id uuid [not null]
  type varchar(20) [not null, note: 'EXAMINATION_FEE in Iteration 1']
  status varchar(20) [not null, note: 'PENDING, PAID, EXEMPT, CANCELLED']
  total_amount numeric [not null]
  insurance_amount numeric [not null]
  patient_amount numeric [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (visit_id, type) [unique, name: 'uq_payments_visit_type']
    (status, created_at) [name: 'idx_payments_status_created_at']
  }

  Note: 'All amounts must be non-negative and total_amount must equal insurance_amount plus patient_amount. Full cashier processing remains Iteration 2.'
}

Table payment_items {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  payment_id uuid [not null]
  service_id uuid [not null]
  service_code_snapshot varchar(40) [not null]
  service_name_snapshot text [not null]
  clinic_price_snapshot numeric [not null]
  insurance_price_snapshot numeric [not null]
  insurance_amount numeric [not null]
  patient_amount numeric [not null]

  indexes {
    payment_id [name: 'idx_payment_items_payment_id']
    service_id [name: 'idx_payment_items_service_id']
  }

  Note: 'Snapshots prevent later service or price updates from changing an existing examination fee.'
}

// Existing authentication relationships

Ref fk_auth_sessions_staff_accounts: auth_sessions.staff_account_id > staff_accounts.id [delete: restrict]
Ref fk_refresh_tokens_auth_sessions: refresh_tokens.auth_session_id > auth_sessions.id [delete: cascade]
Ref fk_security_audit_actor: security_audit_events.actor_account_id > staff_accounts.id [delete: restrict]
Ref fk_security_audit_target: security_audit_events.target_account_id > staff_accounts.id [delete: restrict]

// Organization and catalog relationships

Ref fk_services_departments: services.department_id > departments.id [delete: restrict]
Ref fk_services_service_groups: services.service_group_id > service_groups.id [delete: restrict]
Ref fk_service_prices_services: service_prices.service_id > services.id [delete: restrict]
Ref fk_service_prices_creator: service_prices.created_by > staff_accounts.id [delete: restrict]
Ref fk_rooms_departments: rooms.department_id > departments.id [delete: restrict]
Ref fk_rooms_service_groups: rooms.service_group_id > service_groups.id [delete: restrict]
Ref fk_staff_room_account: staff_room_assignments.staff_account_id > staff_accounts.id [delete: restrict]
Ref fk_staff_room_room: staff_room_assignments.room_id > rooms.id [delete: restrict]
Ref fk_staff_room_assigner: staff_room_assignments.assigned_by > staff_accounts.id [delete: restrict]

// Patient and reception relationships

Ref fk_patients_creator: patients.created_by > staff_accounts.id [delete: restrict]
Ref fk_visits_patients: visits.patient_id > patients.id [delete: restrict]
Ref fk_visits_registrar: visits.registered_by > staff_accounts.id [delete: restrict]
Ref fk_visit_room_visits: visit_room_assignments.visit_id > visits.id [delete: restrict]
Ref fk_visit_room_rooms: visit_room_assignments.room_id > rooms.id [delete: restrict]
Ref fk_visit_room_assigner: visit_room_assignments.assigned_by > staff_accounts.id [delete: restrict]
Ref fk_payments_visits: payments.visit_id > visits.id [delete: restrict]
Ref fk_payment_items_payments: payment_items.payment_id > payments.id [delete: cascade]
Ref fk_payment_items_services: payment_items.service_id > services.id [delete: restrict]

Note implementation_requirements {
  '''
    PostgreSQL/Flyway requirements that DBML cannot fully express:

    1. Use named CHECK constraints for allowed status/type values and amount invariants.
    2. Add the documented partial unique indexes for active visits, active room assignments,
       and active staff-room assignments.
    3. Use application-generated UUIDv7 values; do not use database identity columns.
    4. Do not seed departments, service groups, services, or prices until ownership and seed
       data are approved.
    5. Patient field requiredness, insurance-card history, money representation, queue-number
       reset scope, deletion behavior, and retention remain TBD.
  '''
}
