Project clinic_management_iteration_1 {
  database_type: 'PostgreSQL'
  Note: '''
    Proposed Iteration 1 schema for dbdiagram.io.
    Decisions: docs/iteration-1-decisions.md (I1-Dxx) and docs/use-cases/staff-account.md (AQ-xx).

    Existing authentication tables from Flyway V1 are included for context.
    All technical UUIDs are UUIDv7 values generated by the application.
    This is a review artifact; the executable schema is backend/src/main/resources/db/migration/V2__create_iteration_1_schema.sql.
  '''
}

// Existing Flyway V1 tables

Table staff_accounts {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  username varchar(50) [not null, unique, note: 'Stored lowercase; compared case-insensitively']
  password_hash text [not null]
  full_name text [not null]
  academic_title text
  phone_number text
  email text
  role varchar(20) [not null, note: 'ADMIN, RECEPTIONIST, DOCTOR, TECHNICIAN, CASHIER']
  status varchar(20) [not null, note: 'ACTIVE, LOCKED']
  password_change_required boolean [not null]
  failed_login_attempts integer [not null, default: 0]
  login_blocked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]
  date_of_birth date [note: 'Planned: optional, in the past (AQ-15)']
  gender varchar(20) [note: 'Planned: MALE, FEMALE, OTHER; optional (AQ-15)']
  address text [note: 'Planned: optional, at most 255 characters (AQ-15)']
  created_by_account_id uuid [note: 'Planned: creating Admin; null for the bootstrap Admin']
  last_login_at timestamptz [note: 'Planned: last successful login']
  password_changed_at timestamptz [note: 'Planned: last UC-3 change or UC-11 reset']
  lock_reason text [note: 'Planned: required while LOCKED, at most 500 characters (UC-10)']
  locked_at timestamptz [note: 'Planned: set while LOCKED']
  locked_by_account_id uuid [note: 'Planned: locking Admin, set while LOCKED']

  indexes {
    (role, status) [name: 'idx_staff_accounts_role_status']
  }

  Note: '''
    Existing table. CHECK constraints enforce lowercase username, allowed role/status values, and non-negative failed-login attempts.
    Added in V2 (docs/use-cases/staff-account.md, Report 3): the columns marked "Planned" and a unique index on lower(email).
    Added with UC-10: a CHECK that lock_reason, locked_at, and locked_by_account_id are set exactly when status = LOCKED (accounts can be LOCKED today without lock details).
    phone_number and email stay nullable because the bootstrap Admin is created without them; UC-4, UC-7, and UC-8 require them (AQ-06).
    Planned CHECKs: phone_number 10 digits starting with 0; email at most 100 characters; academic_title at most 50; address at most 255; gender values.
  '''
}

Table auth_sessions {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  staff_account_id uuid [not null]
  created_at timestamptz [not null]
  absolute_expires_at timestamptz [not null]
  revoked_at timestamptz
  revocation_reason varchar(30)

  indexes {
    staff_account_id [name: 'idx_auth_sessions_staff_account_id']
  }

  Note: 'Existing table. Revoked time and reason must either both be null or both be present.'
}

Table refresh_tokens {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  auth_session_id uuid [not null]
  token_hash bytea [not null, unique, note: 'Exactly 32 bytes; raw refresh tokens are never persisted']
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  used_at timestamptz

  indexes {
    auth_session_id [name: 'idx_refresh_tokens_auth_session_id']
  }
}

Table security_audit_events {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  occurred_at timestamptz [not null]
  event_type varchar(40) [not null]
  actor_account_id uuid
  target_account_id uuid
  outcome varchar(10) [not null, note: 'SUCCESS or FAILURE']
  correlation_id varchar(64)

  indexes {
    (target_account_id, occurred_at) [name: 'idx_security_audit_events_target_occurred', note: 'Planned: UC-6 recent activity (AQ-18)']
  }

  Note: 'Existing append-only security audit. Never stores passwords, tokens, or medical data.'
}

// Organization and reference catalog

Table departments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  name varchar(100) [not null, note: 'Unique, compared case-insensitively (I1-D04)']
  type varchar(20) [not null, note: 'CLINICAL or PARACLINICAL; cannot change once the department has a room']
  description varchar(500)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_account_id uuid [note: 'Last Admin who updated it (R3 UC-13 "Last updated by"); null until first update']
  version bigint [not null]

  indexes {
    type [name: 'idx_departments_type']
  }

  Note: 'Flyway adds a unique index on lower(name) (I1-D04). No department code. No create or deactivate use case exists (OQ-07).'
}

Table service_groups {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  type varchar(20) [not null, note: 'LAB, IMAGING, or FUNCTIONAL (R3 UC-17, UC-22)']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  Note: 'Reference data with no management use case. Development gets demo rows from the dev seed; production rows wait for I1-D02.'
}

Table services {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  code varchar(20) [not null, unique]
  name varchar(200) [not null]
  type varchar(20) [not null, note: 'EXAMINATION, LAB, IMAGING, or FUNCTIONAL']
  department_id uuid [note: 'Null only for the shared EXAMINATION service (I1-D06); required otherwise']
  service_group_id uuid [note: 'Null for EXAMINATION; required for LAB, IMAGING, FUNCTIONAL']
  clinic_price numeric(15,0) [not null, note: 'Whole VND, > 0 and <= 100,000,000 (I1-D22)']
  insurance_price numeric(15,0) [note: 'Null = not covered by insurance; otherwise 0 to 100,000,000 (I1-D22)']
  description text
  status varchar(20) [not null, note: 'ACTIVE or INACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (department_id, status) [name: 'idx_services_department_status']
    (service_group_id, status) [name: 'idx_services_group_status']
  }

  Note: '''
    Prices live on the service; payment lines snapshot them (I1-D27), so no price-history table.
    CHECKs: (type = EXAMINATION) = (department_id IS NULL) = (service_group_id IS NULL); price ranges.
    Flyway adds a partial unique index on (type) WHERE type = 'EXAMINATION' AND status = 'ACTIVE': one active shared examination service (I1-D06).
    That the department type matches the service type, and the group type matches the service type, is checked by the application (cross-table).
    Management use cases (UC-20 to UC-25) are outside Iteration 1; Iteration 1 reads the shared examination service for the fee.
  '''
}

Table rooms {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  department_id uuid [not null]
  service_group_id uuid [note: 'Required for PARACLINICAL, null for EXAMINATION']
  code varchar(20) [not null, unique, note: 'Letters, digits, hyphen; unique including inactive rooms (I1-D05)']
  name varchar(100) [not null]
  location varchar(255) [not null, note: 'Building, floor, room number (R3 UC-17)']
  type varchar(20) [not null, note: 'EXAMINATION or PARACLINICAL; follows the department type']
  status varchar(20) [not null, note: 'ACTIVE or INACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (department_id, status) [name: 'idx_rooms_department_status']
    service_group_id [name: 'idx_rooms_service_group_id']
  }

  Note: 'CHECKs: code format; (type = PARACLINICAL) = (service_group_id IS NOT NULL). Room type matching the department type is checked by the application.'
}

Table staff_room_assignments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  staff_account_id uuid [not null]
  room_id uuid [not null]
  assigned_at timestamptz [not null]
  assigned_by_account_id uuid [note: 'Null for rows loaded by a data migration, which has no acting Admin']
  removed_at timestamptz
  removed_by_account_id uuid [note: 'Admin who removed it, through UC-15 or a role change in UC-9 (AQ-09, AQ-16)']
  version bigint [not null]

  indexes {
    staff_account_id [name: 'idx_staff_room_assignments_account_id']
    room_id [name: 'idx_staff_room_assignments_room_id']
  }

  Note: '''
    Flyway adds a partial unique index on (staff_account_id) WHERE removed_at IS NULL: at most one active room per Doctor or Technician (I1-D09, AQ-12).
    CHECK: removed_at and removed_by_account_id are both null or both set.
    Only Doctor and Technician accounts, matching the room type, are assigned; checked by the application. Shifts are out of scope (I1-D10).
  '''
}

// Patient profiles and reception

Table patients {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  patient_code varchar(20) [not null, unique, note: 'BN + 8 digits from a sequence (I1-D26a)']
  full_name varchar(100) [not null]
  date_of_birth date [not null, note: 'Not in the future, at most 120 years ago (application)']
  gender varchar(20) [not null, note: 'MALE, FEMALE, OTHER']
  citizen_id varchar(12) [unique, note: 'Exactly 12 digits; required from age 14 (application); unique when present (I1-D13, I1-D14)']
  phone_number varchar(10) [note: '10 digits starting with 0; required from age 18 (application)']
  address text [not null, note: 'Single free-text field (I1-D15)']
  occupation text
  ethnicity text [not null, note: 'Application default Kinh']
  nationality text [not null, note: 'Application default Viet Nam']
  guardian_name varchar(100) [note: 'Guardian fields required under age 18 (application, I1-D16)']
  guardian_phone_number varchar(10)
  guardian_relationship text
  created_by_account_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    phone_number [name: 'idx_patients_phone_number']
    date_of_birth [name: 'idx_patients_date_of_birth', note: 'Duplicate warning on full name + date of birth (I1-D19)']
  }

  Note: '''
    CHECKs: citizen_id and phone formats; guardian fields all null or name and relationship present.
    No insurance-card column: card data is stored per visit (I1-D17). Medical history and allergies are added with UC-39.
    Name search ignores case and Vietnamese diacritics (R3 UC-35); its index is chosen with the search technique (I1-D11).
  '''
}

Table visits {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  registration_code varchar(20) [not null, unique, note: 'DK + 10 digits from a sequence (I1-D26a)']
  patient_id uuid [not null]
  registered_by_account_id uuid [not null]
  visit_type varchar(20) [not null, note: 'INSURANCE or SELF_PAID']
  priority boolean [not null, default: false]
  priority_reason varchar(20) [note: 'ELDERLY or FRAIL_DISABLED; set exactly when priority (I1-D39)']
  reason_for_visit varchar(500) [not null]
  initial_symptoms varchar(1000)
  insurance_card_number varchar(15) [note: 'Set exactly when visit_type = INSURANCE (I1-D18)']
  insurance_benefit_code smallint [note: '1 to 5']
  insurance_expiry_date date
  insurance_coverage_rate smallint [note: 'Percent returned by the portal, 1 to 100 (I1-D18)']
  insurance_verified_at timestamptz [note: 'When UC-74 verified the card for this visit']
  status varchar(30) [not null, note: 'WAITING_FEE_PAYMENT, WAITING, SKIPPED, IN_EXAMINATION, WAITING_PARACLINICAL, WAITING_CONCLUSION, COMPLETED, CANCELLED, ABANDONED']
  registered_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (patient_id, registered_at) [name: 'idx_visits_patient_registered_at']
    (status, registered_at) [name: 'idx_visits_status_registered_at']
    insurance_card_number [name: 'idx_visits_insurance_card_number', note: 'UC-35 search by card number used in previous visits']
  }

  Note: '''
    Flyway adds a partial unique index on (patient_id) WHERE status NOT IN ('COMPLETED', 'CANCELLED', 'ABANDONED'): one active visit per patient (BR-17).
    CHECKs: allowed status/type values; priority_reason set exactly when priority; the five insurance columns set exactly when visit_type = INSURANCE; benefit code 1 to 5; coverage rate 1 to 100.
    Iteration 1 creates visits in WAITING_FEE_PAYMENT or WAITING only; the other statuses come from Report 3 and are used by later use cases.
    The current room is the active row in visit_room_assignments.
  '''
}

Table visit_room_assignments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  visit_id uuid [not null]
  room_id uuid [not null]
  queue_date date [not null, note: 'Clinic local date, Asia/Ho_Chi_Minh (I1-D28a)']
  queue_number integer [not null, note: '>= 1']
  kind varchar(20) [not null, note: 'REGISTRATION in Iteration 1; TRANSFER added with UC-48']
  assigned_by_account_id uuid [not null]
  assigned_at timestamptz [not null]
  ended_at timestamptz

  indexes {
    (room_id, queue_date, queue_number) [unique, name: 'uq_visit_room_assignments_queue']
    visit_id [name: 'idx_visit_room_assignments_visit_id']
  }

  Note: 'Queue numbers are per room per day (I1-D28). The active assignment has ended_at IS NULL; Flyway adds a partial unique index on (visit_id) WHERE ended_at IS NULL.'
}

Table room_queue_counters {
  room_id uuid [pk, not null]
  queue_date date [pk, not null]
  last_queue_number integer [not null, note: '>= 1']

  Note: '''
    One row per room and day; the registration transaction inserts or increments it (INSERT ... ON CONFLICT DO UPDATE ... RETURNING), so concurrent registrations get consecutive numbers without gaps or duplicates.
    Composite natural primary key: the row has no identity of its own (documented exception to the id convention).
  '''
}

Table payments {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  invoice_number varchar(20) [not null, unique, note: 'HD + 10 digits from a sequence, assigned at creation (I1-D26, I1-D26a)']
  visit_id uuid [not null]
  type varchar(20) [not null, note: 'EXAMINATION_FEE in Iteration 1; PARACLINICAL added with UC-49']
  status varchar(20) [not null, note: 'PENDING, PAID, CANCELLED (no EXEMPT, I1-D25)']
  total_amount numeric(15,0) [not null]
  insurance_total_amount numeric(15,0) [not null]
  patient_total_amount numeric(15,0) [not null]
  paid_at timestamptz [note: 'Set exactly when PAID; for fee-exempt payments, the registration time']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null]

  indexes {
    (visit_id, type) [unique, name: 'uq_payments_visit_type', note: 'One examination-fee payment per visit; revisited when paraclinical payments are added']
    (status, created_at) [name: 'idx_payments_status_created_at']
  }

  Note: '''
    CHECKs: amounts >= 0; total_amount = insurance_total_amount + patient_total_amount; paid_at set exactly when status = PAID.
    Totals are the sums of the lines (checked by the application). A payment whose patient_total_amount is 0 is fee-exempt and created as PAID (I1-D23 rule 6).
    Payment method and confirming Cashier are added with UC-71.
  '''
}

Table payment_items {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  payment_id uuid [not null]
  service_id uuid [not null]
  service_code_snapshot varchar(20) [not null]
  service_name_snapshot varchar(200) [not null]
  price_type varchar(20) [not null, note: 'INSURANCE (covered line) or CLINIC (I1-D23 rule 1)']
  applied_price numeric(15,0) [not null, note: 'Insurance price or clinic price at creation (rule 1)']
  coverage_rate smallint [note: 'Percent 1 to 100; set exactly when price_type = INSURANCE (rule 3)']
  insurance_amount numeric(15,0) [not null, note: 'round_half_up(applied_price x coverage_rate), or 0 (rule 2)']
  patient_amount numeric(15,0) [not null, note: 'applied_price - insurance_amount (rule 4)']

  indexes {
    payment_id [name: 'idx_payment_items_payment_id']
    service_id [name: 'idx_payment_items_service_id']
  }

  Note: 'Snapshots taken when the line is created (I1-D27). CHECKs (I1-D23 rule 7): insurance_amount >= 0; patient_amount >= 0; insurance_amount + patient_amount = applied_price; price_type = CLINIC implies insurance_amount = 0 and coverage_rate IS NULL; price_type = INSURANCE implies coverage_rate IS NOT NULL.'
}

// Business audit

Table business_audit_events {
  id uuid [pk, not null, note: 'Application-generated UUIDv7']
  occurred_at timestamptz [not null]
  actor_account_id uuid [not null]
  event_type varchar(40) [not null, note: 'Iteration 1 events listed in I1-D35']
  entity_type varchar(30) [not null, note: 'PATIENT, VISIT, PAYMENT, DEPARTMENT, ROOM, STAFF_ROOM_ASSIGNMENT']
  entity_id uuid [not null]
  outcome varchar(10) [not null, note: 'SUCCESS or FAILURE']
  changed_fields text[] [note: 'Names of changed fields; never values for patients']
  changes jsonb [note: 'Old and new values; only for DEPARTMENT and ROOM']
  correlation_id varchar(64)

  indexes {
    (entity_type, entity_id, occurred_at) [name: 'idx_business_audit_events_entity']
  }

  Note: '''
    Append-only; written in the same transaction as the change (I1-D35). Never stores passwords, tokens, patient field values, or medical data.
    CHECK: changes is null unless entity_type IN ('DEPARTMENT', 'ROOM'). No API reads it in Iteration 1.
  '''
}

// Simulated external system (UC-74)

Table simulated_insurance_cards {
  card_number varchar(15) [pk, not null, note: 'Natural key: the portal looks cards up by number']
  full_name varchar(100) [not null]
  date_of_birth date [not null]
  benefit_code smallint [not null, note: '1 to 5']
  coverage_rate smallint [not null, note: 'Percent 1 to 100, returned as-is to the visit (I1-D18)']
  valid_from date [not null]
  valid_to date [not null]
  primary_care_facility text [not null]
  status varchar(20) [not null, note: 'VALID or REVOKED']

  Note: '''
    Stands in for the insurance portal (I1-D38). Read only by the simulator adapter, never by domain code; no foreign keys to or from domain tables.
    Demo rows come from the development seed.
  '''
}

// Account relationships

Ref fk_auth_sessions_staff_accounts: auth_sessions.staff_account_id > staff_accounts.id [delete: restrict]
Ref fk_refresh_tokens_auth_sessions: refresh_tokens.auth_session_id > auth_sessions.id [delete: cascade]
Ref fk_security_audit_actor: security_audit_events.actor_account_id > staff_accounts.id [delete: restrict]
Ref fk_security_audit_target: security_audit_events.target_account_id > staff_accounts.id [delete: restrict]
Ref fk_staff_accounts_creator: staff_accounts.created_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_staff_accounts_locker: staff_accounts.locked_by_account_id > staff_accounts.id [delete: restrict]

// Organization and catalog relationships

Ref fk_departments_updater: departments.updated_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_services_departments: services.department_id > departments.id [delete: restrict]
Ref fk_services_service_groups: services.service_group_id > service_groups.id [delete: restrict]
Ref fk_rooms_departments: rooms.department_id > departments.id [delete: restrict]
Ref fk_rooms_service_groups: rooms.service_group_id > service_groups.id [delete: restrict]
Ref fk_staff_room_account: staff_room_assignments.staff_account_id > staff_accounts.id [delete: restrict]
Ref fk_staff_room_room: staff_room_assignments.room_id > rooms.id [delete: restrict]
Ref fk_staff_room_assigner: staff_room_assignments.assigned_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_staff_room_remover: staff_room_assignments.removed_by_account_id > staff_accounts.id [delete: restrict]

// Patient and reception relationships

Ref fk_patients_creator: patients.created_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_visits_patients: visits.patient_id > patients.id [delete: restrict]
Ref fk_visits_registrar: visits.registered_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_visit_room_visits: visit_room_assignments.visit_id > visits.id [delete: restrict]
Ref fk_visit_room_rooms: visit_room_assignments.room_id > rooms.id [delete: restrict]
Ref fk_visit_room_assigner: visit_room_assignments.assigned_by_account_id > staff_accounts.id [delete: restrict]
Ref fk_room_queue_counters_rooms: room_queue_counters.room_id > rooms.id [delete: restrict]
Ref fk_payments_visits: payments.visit_id > visits.id [delete: restrict]
Ref fk_payment_items_payments: payment_items.payment_id > payments.id [delete: restrict]
Ref fk_payment_items_services: payment_items.service_id > services.id [delete: restrict]
Ref fk_business_audit_actor: business_audit_events.actor_account_id > staff_accounts.id [delete: restrict]

Note implementation_requirements {
  '''
    PostgreSQL/Flyway requirements that DBML cannot fully express (decisions in docs/iteration-1-decisions.md):

    1. Use named CHECK constraints for allowed status/type values, formats, amount invariants, and the "set exactly when" rules noted on each table.
    2. Add the documented partial and expression unique indexes: active visit per patient, active room assignment per visit,
       active room per staff account, one active EXAMINATION service, lower(departments.name), lower(staff_accounts.email).
    3. Use application-generated UUIDv7 values; do not use database identity columns. Business codes use sequences
       patient_code_seq, registration_code_seq, invoice_number_seq.
    4. Money is numeric(15,0), whole VND (I1-D22, I1-D22a).
    5. Production migrations contain no business reference data. Demo data for departments, service groups, services, rooms,
       and staff lives in a separate Flyway location enabled only by the development profile (I1-D01, I1-D03).
    6. payment_items uses RESTRICT, not CASCADE: payments are never deleted (R3 §IV.2.3 No data deletion).
    7. Amounts follow the Money Calculation section of docs/iteration-1-decisions.md; the database checks that each line reconciles.
    8. simulated_insurance_cards is outside the domain model (I1-D38).
  '''
}
