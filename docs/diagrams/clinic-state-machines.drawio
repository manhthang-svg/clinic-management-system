        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="447" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Tạo và chuyển chi tiết" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="479" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Tạo chi tiết ở PENDING_PAYMENT. Chuyển ngay sang WAITING với lượt BHYT hoặc phiếu miễn phí. Với lượt tự trả còn phí, chuyển sau khi thanh toán. Phiếu còn lại 0 đ sau khi hủy một dòng cũng được chuyển." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="479" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Tiếp nhận và trả về" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="523" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Kỹ thuật viên tiếp nhận dịch vụ đã check-in → IN_PROGRESS. Kỹ thuật viên đã tiếp nhận có thể trả về WAITING khi chưa thể thực hiện, giữ số thứ tự." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="523" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Thực hiện và gửi kết quả" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="567" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Kỹ thuật viên đã tiếp nhận xác nhận thực hiện xong → PENDING_RESULT. Khi người thực hiện gửi kết quả, chi tiết → COMPLETED từ IN_PROGRESS hoặc PENDING_RESULT." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="567" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Hủy và chốt cuối ngày" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="611" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="Bác sĩ hủy trước khi kỹ thuật viên tiếp nhận, có lý do, hồ sơ mở, lượt đang chờ CLS và phiếu còn tính lại được. Khi chốt lượt cuối ngày, chi tiết chưa kết thúc → ABANDONED." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="611" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Phiếu chỉ định" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="655" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="Phiếu cha chuyển PENDING_PAYMENT → RELEASED khi chuyển dịch vụ. Phiếu có thể bị hủy khi mọi chi tiết bị hủy hoặc khi chốt lượt cuối ngày mà còn chi tiết chưa hoàn thành." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="655" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-5" value="Thông tin hàng chờ" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="699" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-5" value="Check-in, bỏ qua và bỏ cờ bỏ qua thay đổi thông tin hàng chờ, giữ nguyên status." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="699" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="ParaclinicalOrderDetail.java · ParaclinicalOrder.java · ParaclinicalOrderServiceImpl.java · TechnicianQueueServiceImpl.java · ParaclinicalResultServiceImpl.java" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#52647C;align=left;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="754" width="1308" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
