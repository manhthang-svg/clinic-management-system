        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="521" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Lưu đơn lần đầu" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="553" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Bác sĩ lưu đơn lần đầu, tạo đơn ở PENDING." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="553" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Kết quả liên thông" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="597" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Bác sĩ có thể ký và gửi từ PENDING, SENT hoặc REJECTED. Server liên thông không phản hồi → SENT, từ chối → REJECTED, chấp nhận → ACCEPTED. Cùng một kết quả khi gửi lại có thể giữ nguyên trạng thái." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="597" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Xóa đơn" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="641" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Chỉ đơn PENDING được xóa khi thao tác đáp ứng điều kiện của hồ sơ. Ô nét đứt biểu thị kết thúc do xóa bản ghi." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="641" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Sửa, khóa và in" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="685" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="PENDING và REJECTED có thể được sửa khi hồ sơ cho phép. SENT có thể gửi lại. ACCEPTED khóa sửa đơn và là điều kiện để in đơn sau khi đã đóng hồ sơ." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="685" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Ký và gửi" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="729" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="SigningRequest quản lý quá trình ký riêng. Các mũi tên giữa các trạng thái liên thông cho biết kết quả của mỗi lần gửi đơn đã ký." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="729" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Prescription.java · PrescriptionServiceImpl.java · PrescriptionSigningServiceImpl.java · UC-59/60/90/91/92" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#52647C;align=left;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="784" width="1308" height="25" as="geometry" />
        </mxCell>
      </root>
