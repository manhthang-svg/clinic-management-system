        </mxCell>
        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="347" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Tạo hồ sơ" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="379" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Tạo hồ sơ khi ghi khám hoặc lập chỉ định CLS nếu chưa có hồ sơ cho lượt. Backend tạo hồ sơ ở OPEN." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="379" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Xác nhận kết luận" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="423" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Bác sĩ xác nhận kết luận theo UC-58. Lượt đủ điều kiện, hồ sơ đang mở, đã xử lý xong CLS và đơn thuốc nếu có đã được chấp nhận. Hồ sơ chuyển LOCKED và lượt chuyển COMPLETED." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="423" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Chốt cuối ngày" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="467" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Tác vụ cuối ngày khóa hồ sơ đang mở nếu có, khi lượt được chốt ở CANCELLED hoặc ABANDONED. Luồng này ghi thời điểm khóa." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="467" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Sau khi khóa" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="511" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="Các luồng xem, in và xuất tuân theo điều kiện của từng use case. Chúng giữ nguyên trạng thái hồ sơ." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="511" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Lưu trữ" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="555" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="Enum MedicalRecordStatus có ARCHIVED. Luồng đóng hồ sơ tạo bản ghi RecordArchive riêng và giữ MedicalRecord ở LOCKED. Backend hiện chưa có nhánh chuyển hồ sơ sang ARCHIVED." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="555" width="1128" height="44" as="geometry" />
        </mxCell>
