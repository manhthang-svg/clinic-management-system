        <mxCell id="edge-4" value="Lễ tân hủy lịch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#A65A4F;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.72;entryX=0;entryY=0.5;" edge="1" parent="1" source="SCHEDULED" target="CANCELLED">
