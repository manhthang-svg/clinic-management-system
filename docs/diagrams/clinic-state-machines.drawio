          </mxGeometry>
        </mxCell>
        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="476" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Tiếp nhận" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="508" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Tiếp nhận. Lượt tự trả có phí phải thu bắt đầu ở WAITING_FEE_PAYMENT. Lượt BHYT hoặc phần người bệnh trả bằng 0 bắt đầu ở WAITING." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="508" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Trả phí và gọi khám" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="552" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Thanh toán phí khám và cấp số chờ → WAITING. Bác sĩ gọi vào khám, kể cả tiếp nhận lại lượt đã bỏ qua ở hàng chờ → IN_EXAMINATION." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="552" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Chuyển phòng và chỉ định" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="596" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Chuyển phòng khi đang khám → WAITING tại phòng mới. Chỉ định CLS từ đang khám hoặc chờ kết luận → WAITING_PARACLINICAL." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="596" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Xử lý CLS và kết luận" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="640" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="Mọi chi tiết CLS đã kết thúc và không có chi tiết ABANDONED → WAITING_CONCLUSION. Xác nhận kết luận và khóa hồ sơ khi lượt không bị bỏ qua → COMPLETED." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="640" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Chốt cuối ngày" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="684" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="Tác vụ cuối ngày hủy lượt chưa trả phí khám. Lượt chưa kết thúc ở một trong bốn trạng thái chờ khám, đang khám, chờ CLS hoặc chờ kết luận → ABANDONED." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="684" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-5" value="Cờ bỏ qua" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="728" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-5" value="Bỏ qua khi chờ khám hoặc chờ kết luận chỉ đổi isSkipped. Tiếp nhận lại ở chờ kết luận xóa cờ và giữ trạng thái. Gọi tiếp để kết luận cũng giữ trạng thái." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="728" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Visit.java · VisitServiceImpl.java · VisitTransferServiceImpl.java · ParaclinicalProgressServiceImpl.java · MedicalRecordClosureServiceImpl.java · VisitEndOfDayServiceImpl.java" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#52647C;align=left;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="783" width="1308" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
