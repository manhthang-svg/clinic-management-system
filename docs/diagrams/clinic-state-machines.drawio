        <mxCell id="edge-3" value="Tính lại&lt;br&gt;còn 0 đ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#406288;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="PENDING" target="FEE_EXEMPT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="Tính lại&lt;br&gt;phát sinh phí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#406288;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="FEE_EXEMPT" target="PENDING">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="Xác nhận thanh toán" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#406288;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="PENDING" target="PAID">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="Hủy dòng cuối hoặc&lt;br&gt;chốt cuối ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#A65A4F;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.78;entryX=0;entryY=0.25;" edge="1" parent="1" source="PENDING" target="CANCELLED">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="734" y="187" /><mxPoint x="734" y="360" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-7" value="Hủy dòng cuối" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#A65A4F;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="FEE_EXEMPT" target="CANCELLED">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="447" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Lập phiếu" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="479" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Khi lập phiếu, phần người bệnh phải trả lớn hơn 0 → PENDING, bằng 0 → FEE_EXEMPT." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="479" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Tính lại số tiền" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="523" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Tính lại quyền lợi BHYT hoặc hủy một dòng CLS. Nếu còn dòng hợp lệ, trạng thái phụ thuộc phần người bệnh phải trả sau khi tính lại. Chỉ tính lại với phiếu PENDING hoặc FEE_EXEMPT chưa gắn mã đơn PayOS." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="523" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Xác nhận thanh toán" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="567" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Thu ngân xác nhận thu tiền hoặc PayOS xác nhận thanh toán hợp lệ. Khoản phí của lượt BHYT được thu sau khi bác sĩ xác nhận kết luận." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="567" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Hủy phiếu" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="611" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="Hủy dòng CLS cuối cùng trên phiếu còn tính lại được sẽ hủy phiếu. Khi chốt lượt cuối ngày, hệ thống hủy phiếu vẫn PENDING." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="611" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Đồng bộ" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="655" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="Phí khám được thanh toán có thể đưa lượt vào hàng chờ. Thanh toán phiếu CLS có thể chuyển các dịch vụ đang PENDING_PAYMENT sang WAITING. Vòng đời giao dịch PayOS nằm ở PaymentTransaction." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="655" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="Payment.java · PaymentServiceImpl.java · PaymentCompletionServiceImpl.java · PayOSPaymentServiceImpl.java · InsuranceCoverageServiceImpl.java · VisitEndOfDayServiceImpl.java" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#52647C;align=left;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="710" width="1308" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
