            <Array as="points"><mxPoint x="720" y="248" /><mxPoint x="720" y="335" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rules-heading" value="Sự kiện và điều kiện chuyển trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#1D3654;strokeColor=#1D3654;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="407" width="1308" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-0" value="Lưu lịch lần đầu" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="439" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-0" value="Bác sĩ lưu lịch lần đầu khi hồ sơ mở, đã có kết luận và ngày hẹn hợp lệ. Mỗi hồ sơ có tối đa một lịch hẹn." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="439" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-1" value="Đăng ký lượt tái khám" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="483" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-1" value="Lễ tân đăng ký lượt khám mới từ lịch hợp lệ, còn hạn và thuộc đúng người bệnh. Lịch ghi nhận mã lượt khám mới." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="483" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-2" value="Quá hạn" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="527" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-2" value="Tác vụ kiểm tra quá hạn chuyển lịch đang SCHEDULED sang MISSED khi ngày hiện tại qua ngày cuối có hiệu lực." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="527" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-3" value="Lễ tân hủy lịch" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="571" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-3" value="Lễ tân hủy lịch đang SCHEDULED và nhập lý do." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#F3F7FB;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="571" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-key-4" value="Giữ nguyên trạng thái" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#1D3654;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="615" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule-text-4" value="Sửa lịch theo UC-61 khi hồ sơ mở và lịch còn SCHEDULED. In giấy hẹn khi hồ sơ đã khóa và lịch còn SCHEDULED. Gửi email nhắc hẹn chỉ ghi nhận thời điểm gửi." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fillColor=#FFFFFF;strokeColor=#D5E0EA;fontColor=#20334D;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="225" y="615" width="1128" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sources" value="FollowUpAppointment.java · FollowUpScheduleServiceImpl.java · FollowUpAppointmentServiceImpl.java · VisitServiceImpl.java · UC-61/62 · UC-75" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#52647C;align=left;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="670" width="1308" height="25" as="geometry" />
        </mxCell>
      </root>
