        <mxCell id="edge-3" value="Quá hạn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#A65A4F;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#152B46;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="SCHEDULED" target="MISSED">
          <mxGeometry relative="1" as="geometry" />
