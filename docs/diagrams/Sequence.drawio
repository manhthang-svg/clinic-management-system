  <diagram id="vE_b2DgarXBjuFfPszVc" name="UC-4">
    <mxGraphModel dx="1704" dy="936" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor User as Staff\n    participant UI as User Profile UI\n    participant API as Profile API\n    participant Auth as Auth Service\n    participant AccountSvc as Account Service\n    participant DB as Database\n    participant History as Change History\n\n    User-&gt;&gt;UI: Mở My Profile\n    UI-&gt;&gt;API: GET /api/v1/me/profile\n    API-&gt;&gt;Auth: Kiểm tra session\n    Auth--&gt;&gt;API: Authorized + accountId\n    API-&gt;&gt;AccountSvc: Get own profile\n    AccountSvc-&gt;&gt;DB: Query account\n    DB--&gt;&gt;AccountSvc: Profile data\n    AccountSvc--&gt;&gt;API: Profile\n    API--&gt;&gt;UI: 200 OK\n    UI--&gt;&gt;User: Hiển thị profile&lt;br/&gt;chỉ Phone và Email được sửa\n\n    opt Nhấn Cancel\n        User-&gt;&gt;UI: Nhấn Cancel\n        UI--&gt;&gt;User: Khôi phục giá trị đang hiển thị\n    end\n\n    User-&gt;&gt;UI: Sửa Phone và hoặc Email, nhấn Save\n    UI-&gt;&gt;API: PUT /api/v1/me/profile&lt;br/&gt;phone + email\n    API-&gt;&gt;Auth: Kiểm tra session\n\n    alt Session hết hạn hoặc không hợp lệ\n        Auth--&gt;&gt;API: Invalid session\n        API--&gt;&gt;UI: 401 Unauthorized\n        UI--&gt;&gt;User: MSG12 và mở Login\n\n    else Session hợp lệ\n        Auth--&gt;&gt;API: Authorized + accountId\n        API-&gt;&gt;AccountSvc: Update own contact\n\n        AccountSvc-&gt;&gt;DB: Kiểm tra account vẫn Active\n        alt Account đã bị Locked\n            DB--&gt;&gt;AccountSvc: Locked\n            AccountSvc--&gt;&gt;API: Rejected\n            API--&gt;&gt;UI: 401 Unauthorized\n            UI--&gt;&gt;User: MSG12\n\n        else Sửa account khác hoặc field read-only\n            AccountSvc--&gt;&gt;API: Forbidden\n            API--&gt;&gt;UI: 403 Forbidden\n            UI--&gt;&gt;User: MSG13\n\n        else Account Active\n            AccountSvc-&gt;&gt;AccountSvc: Validate Phone bắt buộc, 10 số,&lt;br/&gt;bắt đầu bằng 0, đầu số VN hợp lệ&lt;br/&gt;Email tùy chọn, đúng format, tối đa 100 ký tự\n\n            alt Thiếu Phone\n                AccountSvc--&gt;&gt;API: Validation error\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG02 dưới Phone\n\n            else Sai format hoặc quá dài\n                AccountSvc--&gt;&gt;API: Validation error\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG05 hoặc MSG08\n\n            else Hợp lệ\n                AccountSvc-&gt;&gt;DB: Kiểm tra unique Phone và Email&lt;br/&gt;Email không phân biệt hoa thường\n\n                alt Trùng với account khác\n                    DB--&gt;&gt;AccountSvc: Conflict\n                    AccountSvc--&gt;&gt;API: Conflict fields\n                    API--&gt;&gt;UI: 409 Conflict\n                    UI--&gt;&gt;User: MSG07 tại field bị trùng\n\n                else Unique\n                    DB--&gt;&gt;AccountSvc: Unique\n                    AccountSvc-&gt;&gt;AccountSvc: So sánh giá trị cũ và mới\n\n                    alt Không có thay đổi\n                        AccountSvc--&gt;&gt;API: Success, không ghi history\n\n                    else Có thay đổi\n                        AccountSvc-&gt;&gt;DB: BEGIN TRANSACTION\n                        AccountSvc-&gt;&gt;DB: UPDATE phone, email\n                        AccountSvc-&gt;&gt;History: Ghi từng field thay đổi&lt;br/&gt;old value, new value, actor, time\n                        AccountSvc-&gt;&gt;DB: COMMIT\n\n                        alt Unique constraint violation khi concurrent\n                            DB--&gt;&gt;AccountSvc: Violation\n                            AccountSvc-&gt;&gt;DB: ROLLBACK\n                            AccountSvc--&gt;&gt;API: Conflict\n                            API--&gt;&gt;UI: 409 Conflict\n                            UI--&gt;&gt;User: MSG07\n                        else Commit successful\n                            DB--&gt;&gt;AccountSvc: OK\n                            AccountSvc--&gt;&gt;API: Success\n                        end\n                    end\n\n                    API--&gt;&gt;UI: 200 OK + profile mới\n                    UI--&gt;&gt;User: MSG03 và hiển thị profile hiện tại\n                end\n            end\n        end\n    end\n\n    opt Lỗi hệ thống\n        API--&gt;&gt;UI: 5xx\n        UI--&gt;&gt;User: MSG99, profile và history không đổi\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-cVxiJ1LFeZtI4qKHaq--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
