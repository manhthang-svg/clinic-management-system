        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n\n    actor User as Staff\n    participant UI as Change Password UI\n    participant API as Auth API\n    participant Auth as Auth Service\n    participant AccountSvc as Account Service\n    participant DB as Database\n    participant Audit as Audit Log\n\n    alt Bắt buộc đổi sau khi tạo account hoặc reset\n        UI--&gt;&gt;User: MSG46; chỉ My Profile, Change Password và Logout khả dụng\n    else Tự đổi\n        User-&gt;&gt;UI: Mở My Profile và chọn Change Password\n    end\n\n    UI--&gt;&gt;User: Hiển thị Current Password, New Password,&lt;br/&gt;Confirm New Password và password rule\n\n    opt Nhấn Cancel\n        User-&gt;&gt;UI: Nhấn Cancel\n        UI--&gt;&gt;User: Xóa form, không thay đổi gì\n        Note over UI: Không có ở luồng bắt buộc đổi\n    end\n\n    User-&gt;&gt;UI: Nhập 3 field và nhấn Save\n    UI-&gt;&gt;UI: Kiểm tra field rỗng\n    UI-&gt;&gt;UI: Kiểm tra New Password 8 đến 64 ký tự,&lt;br/&gt;tối đa 72 bytes\n    UI-&gt;&gt;UI: Kiểm tra Confirm khớp New Password\n\n    alt Lỗi tại client\n        UI--&gt;&gt;User: MSG02, MSG43 hoặc MSG44 dưới field lỗi\n\n    else Hợp lệ tại client\n        UI-&gt;&gt;API: POST /api/v1/me/commands/change-password&lt;br/&gt;currentPassword + newPassword\n        Note over UI,API: Confirm New Password không gửi lên backend\n        API-&gt;&gt;Auth: Kiểm tra session\n\n        alt Session không hợp lệ hoặc account bị Locked\n            Auth--&gt;&gt;API: Unauthorized\n            API--&gt;&gt;UI: 401 Unauthorized\n            UI--&gt;&gt;User: MSG12 và mở Login\n\n        else Session hợp lệ\n            Auth--&gt;&gt;API: Authorized\n            API-&gt;&gt;AccountSvc: Change password\n            AccountSvc-&gt;&gt;DB: Lấy hash, failedCount, blockedUntil\n            DB--&gt;&gt;AccountSvc: Account security data\n\n            alt Đang bị block 15 phút\n                AccountSvc--&gt;&gt;API: Wrong current password\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG14\n\n            else Current Password sai\n                AccountSvc-&gt;&gt;DB: failedCount = failedCount + 1\n                opt Sai lần thứ 5 liên tiếp\n                    AccountSvc-&gt;&gt;DB: Block password sign-in 15 phút&lt;br/&gt;reset failedCount = 0\n                    AccountSvc-&gt;&gt;Audit: Ghi block\n                    Note over AccountSvc: Session hiện tại vẫn active\n                end\n                AccountSvc--&gt;&gt;API: Wrong current password\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG14\n\n            else New Password vi phạm policy\n                AccountSvc--&gt;&gt;API: Policy error\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG43\n\n            else New Password trùng Current Password\n                AccountSvc--&gt;&gt;API: Same password\n                API--&gt;&gt;UI: 400 Bad Request\n                UI--&gt;&gt;User: MSG39\n\n            else Hợp lệ\n                AccountSvc-&gt;&gt;DB: BEGIN TRANSACTION\n                AccountSvc-&gt;&gt;DB: Lưu hash mới, mustChangePassword = false,&lt;br/&gt;failedCount = 0\n                AccountSvc-&gt;&gt;DB: Revoke mọi session khác&lt;br/&gt;giữ session hiện tại\n                AccountSvc-&gt;&gt;Audit: Ghi password change\n                Note over Audit: Không ghi password\n                AccountSvc-&gt;&gt;DB: COMMIT\n                DB--&gt;&gt;AccountSvc: Commit successful\n                AccountSvc--&gt;&gt;API: Success\n                API--&gt;&gt;UI: 200 OK\n                UI--&gt;&gt;User: MSG15\n\n                opt Đang ở luồng bắt buộc đổi\n                    UI-&gt;&gt;API: POST /api/v1/auth/refresh\n                    API--&gt;&gt;UI: Session không còn restriction\n                    UI--&gt;&gt;User: Mở home screen của role\n                end\n            end\n        end\n    end\n\n    opt Lỗi hệ thống\n        API--&gt;&gt;UI: 5xx\n        UI--&gt;&gt;User: MSG99, password cũ vẫn dùng được\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="L7KxRgORDQWRT8NSzdqS-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
