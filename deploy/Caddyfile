# Same-origin reverse proxy (docs/security.md, decided 14/10/2026).
# TLS ends at Cloudflare; cloudflared reaches this server over the internal Docker network only.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# Backend API, and the simulated CA app (only answers when CLINIC_SIGNINGSIMULATOR_CONSOLEENABLED=true).
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /dev/ca-sim* {
		reverse_proxy backend:8080
	}

	# SPA: unknown paths fall back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
