# Copy to deploy/.env (git-ignored) and replace every placeholder. Never commit deploy/.env.

# Public address users type in the browser; must match the Cloudflare Tunnel public hostname exactly.
APP_FRONTEND_ORIGIN=https://clinic.example.com
CLOUDFLARE_TUNNEL_TOKEN=paste-the-token-from-cloudflare-zero-trust

POSTGRES_PASSWORD=replace-with-a-long-random-password
# Leave DB_URL unset to use the bundled PostgreSQL. To use another database, set DB_URL, DB_USERNAME, DB_PASSWORD.

# Base64 key of at least 256 bits, one per environment: openssl rand -base64 32
JWT_SIGNING_KEY=replace-with-a-base64-encoded-random-256-bit-key

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# PayOS (read by PayOS.fromEnv()). Required: the backend does not start while any of the three is empty.
# Return/cancel URLs must use the public address.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://clinic.example.com/payment/result
PAYOS_CANCEL_URL=https://clinic.example.com/payment/cancel

# UC-67 result images (secret)
CLOUDINARY_URL=

CLINIC_HEALTH_DEPARTMENT=

# UC-90 simulated signing (test keys, no legal value). To sign e-prescriptions in the demo, set a password,
# trust the simulator CA, and enable the /dev/ca-sim app (it is then public at APP_FRONTEND_ORIGIN/dev/ca-sim/).
SIGNING_SIMULATOR_KEYSTORE_PASSWORD=
SIGNING_TRUSTED_CA_FILES=
CLINIC_SIGNINGSIMULATOR_CONSOLEENABLED=false
# SIGNING_SIMULATOR_KEYSTORE_PASSWORD=replace-with-a-random-password
# SIGNING_TRUSTED_CA_FILES=/data/signing-simulator/trusted-ca.pem
# CLINIC_SIGNINGSIMULATOR_CONSOLEENABLED=true
