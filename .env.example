POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# docker compose: host ports of the containers (app at http://localhost:8081)
BACKEND_PORT=8080
FRONTEND_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/clinic
DB_USERNAME=clinic
DB_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SECURE=false
JWT_SIGNING_KEY=replace-with-a-base64-encoded-random-256-bit-key

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# Mock BHXH portal latency; set above 10s to exercise UC-74 EF-04 in the frontend.
INSURANCE_SIMULATOR_RESPONSE_DELAY=0ms

# UC-67 result images: cloudinary://<api_key>:<api_secret>@<cloud_name> (secret, never commit)
CLOUDINARY_URL=

# UC-71 PayOS keys (secret, never commit). Return/cancel pages default to port 5173 (npm run dev) or 8081 (docker compose).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=http://localhost:5173/payment/result
# PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# UC-75 follow-up reminder emails (free). Left empty = local Mailpit (docker compose), inbox http://localhost:8025.
# Real email with Gmail (free, about 500 recipients a day): turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, then fill the values below. MAIL_PASSWORD is a secret, never commit it.
FOLLOW_UP_REMINDER_ENABLED=true
# Gmail: smtp.gmail.com
MAIL_HOST=
# Gmail: 587
MAIL_PORT=
# Gmail address that sends the reminders, e.g. phongkham@gmail.com
MAIL_USERNAME=
# 16-character App Password of that account (no spaces)
MAIL_PASSWORD=
# Same Gmail address as MAIL_USERNAME
MAIL_FROM=
# Gmail: true
MAIL_SMTP_AUTH=
# Gmail: true
MAIL_SMTP_STARTTLS=
# Days before the follow-up date (default 1) and run times (default 08:00, 14:00, 20:00)
FOLLOW_UP_REMINDER_DAYS_BEFORE=1
FOLLOW_UP_REMINDER_CRON=0 0 8,14,20 * * *
