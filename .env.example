POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# docker compose: host ports of the containers (app at http://localhost:8081)
BACKEND_PORT=8080
FRONTEND_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/clinic
DB_USERNAME=clinic
DB_PASSWORD=change-me
APP_FRONTEND_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SECURE=false
JWT_SIGNING_KEY=replace-with-a-base64-encoded-random-256-bit-key

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password
BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# Mock BHXH portal latency; set above 10s to exercise UC-74 EF-04 in the frontend.
INSURANCE_SIMULATOR_RESPONSE_DELAY=0ms

# UC-67 result images: cloudinary://<api_key>:<api_secret>@<cloud_name> (secret, never commit)
CLOUDINARY_URL=

# UC-71 PayOS keys (secret, never commit). Return/cancel pages default to port 5173 (npm run dev) or 8081 (docker compose).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=http://localhost:5173/payment/result
# PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
